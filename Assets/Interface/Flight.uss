#screen { flex-grow: 1; color: rgb(224,238,243); font-size: 16px; }
.header,.footer,.row { flex-direction: row; justify-content: space-between; align-items: center; }
.header { margin: 25px 34px; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: rgba(145,210,212,0.42); }
.kicker,.clock { font-size: 13px; color: rgb(109,231,207); -unity-font-style: bold; }
.title { font-size: 26px; -unity-font-style: bold; }
.reticle { position:absolute; top:48%; left:50%; font-size:24px; color:white; }
.bottom { position:absolute; left:34px; right:34px; bottom:83px; align-items:flex-end; }
.panel { background-color:rgba(9,20,31,0.90); padding:15px 20px; border-left-width: 3px; border-left-color: rgb(83,215,192); }
.telemetry { width:300px; } .navigation { width:240px; } .name { font-size:26px; -unity-font-style:bold; margin-top:4px; margin-bottom:5px; }
.track { margin-top:6px; height:4px; background-color:rgb(43,69,80); } #bar {height:4px;background-color:rgb(110,234,202);}
.footer { position:absolute; bottom:0; left:0; right:0; padding:9px 32px; background-color:rgba(8,16,26,0.92); }
Button { background-color:rgb(25,49,60); color:rgb(222,242,242); border-width:0; border-radius:3px; padding:6px 12px; margin:4px 2px; } Button:hover {background-color:rgb(37,86,93);} #guide { font-size:14px; white-space:normal; flex-shrink:1; }
.map-window { position:absolute; left:10%; right:10%; top:7%; bottom:7%; background-color:rgb(8,20,32); padding:18px; border-width:1px; border-color:rgb(83,215,192); }
.map-header { flex-direction:row; justify-content:space-between; align-items:center; font-size:20px; -unity-font-style:bold; }
.map-plot { flex-grow:1; min-height:100px; margin-top:8px; margin-bottom:8px; background-color:rgb(12,30,45); overflow:hidden; }
.map-marker { position:absolute; font-size:16px; -unity-font-style:bold; }
.map-choices { flex-direction:row; flex-wrap:wrap; }
.warp-info { margin-top:6px; color:rgb(109,231,207); white-space:normal; }
.main-menu { position:absolute; left:0; right:0; top:0; bottom:0; align-items:center; justify-content:center; background-color:rgba(5,12,21,0.96); }
.main-menu-panel { width:420px; max-width:90%; padding:28px; background-color:rgb(13,31,42); border-left-width:3px; border-left-color:rgb(83,215,192); }
.main-menu-title { font-size:22px; -unity-font-style:bold; color:rgb(109,231,207); margin-bottom:20px; white-space:normal; }
.main-menu Button { margin-top:7px; padding:10px; }
.main-menu Slider, .main-menu Toggle { margin-top:12px; margin-bottom:12px; }
.part-row { flex-direction:row; align-items:center; min-height:30px; }
.part-name { flex-grow:1; border-left-width:7px; padding-left:8px; }
.part-row Button { margin:1px; padding:2px 7px; }
.part-palette { flex-direction:row; flex-wrap:wrap; }
.part-palette Button { margin:2px; padding:4px; }
.design-stats { margin-top:8px; margin-bottom:8px; color:rgb(109,231,207); white-space:normal; }
